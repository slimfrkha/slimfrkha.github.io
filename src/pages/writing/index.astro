---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { presentations } from '../../data/presentations';
import { site } from '../../data/site';
---

<BaseLayout title="Writing" description={`Technical presentations by ${site.name}.`}>
  <section>
    <div class="section-label">Writing</div>

    <div class="subhead">
      <span>Presentations</span>
      <span class="subhead-note faint mono">slide decks</span>
    </div>
    {presentations.map((p) => (
      <div class="item">
        <div class="head">
          <h3><a href={`/writing/${p.slug}/`}>{p.title}</a></h3>
          <span class="meta">{p.context}</span>
        </div>
        <p class="dim" style="margin:0.25rem 0 0;">{p.summary}</p>
      </div>
    ))}
  </section>
</BaseLayout>
